[node name="LastKnightSpot" parent="." instance=ExtResource("7_lore")]
position = Vector2(1500, 252)
npc_id = "last_knight"
display_name = "THE LAST KNIGHT"
portrait = "knight"
lines = PackedStringArray("Halt. ... No. Forgive me. The order to halt outsiders died with the captain.", "I am the last posting of the Throne Guard. I keep the antechamber. I will keep it until I stop.", "What sits past those doors is not the King. The King is buried in the Warrens — you of all things know.", "It wears his grief like the crown. If you go in, go in as a blade. Mourning is how it catches you.")
location_name = "THE SOVEREIGN'S THRONE"
location_subtitle = "DESCENT VI"
reveals_location = false

