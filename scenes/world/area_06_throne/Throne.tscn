[node name="SovereignEcho" parent="." instance=ExtResource("7_lore")]
position = Vector2(2440, 252)
npc_id = "pale_sovereign"
display_name = "THE PALE SOVEREIGN"
portrait = "sovereign"
reveals_location = false
lines = PackedStringArray("...you. The blade the surface sent down to audit our grief.", "I watched you unmake everything that kept the kingdom asleep. The brood. The forge. The binding. The King.", "I am what remains when a king's promise outlives the king. I cannot stop keeping it.", "Before you draw on me, wanderer — answer. The deep listens to its last visitor.")
choice_prompt = "When the throne is empty — what becomes of Cairn?"
choice_options = PackedStringArray("It must fall. The dead deserve an ending.", "It must endure. I will keep it myself.")
choice_flags = PackedStringArray("choice_fall", "choice_endure")

