[node name="LoreNPC" type="Node2D"]
script = ExtResource("1_lore")
lines = PackedStringArray("You move. After a hundred years of stillness... something finally moves.", "This was Cairn. A kingdom that chose the deep, long before the surface forgot us.", "Then came the Silencing. In one breath, all of it stopped — everything but me, and now you.", "I am only a fragment of who I was. A shade, clinging to the stone.", "Follow the cairns downward, stranger. The stones remember the way.", "Find what silenced us... and decide whether Cairn deserves to wake, or to rest.")

