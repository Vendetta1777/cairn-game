; Engine configuration file.
; Cairn — dark fantasy metroidvania-roguelite.
; Generated for Milestone 1. Open in Godot 4.3+ to edit visually.

config_version=5

[application]

config/name="Cairn"
config/description="A cairn marks a grave. Or a path. In the deep, no one remembers which."
run/main_scene="res://scenes/test/TestLevel.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

; Global singletons. More will be added as systems come online (M6).
GameManager="*res://scenes/systems/GameManager.gd"

[display]

; Pixel-art baseline: low native res scaled up, nearest-neighbour filtering, no AA.
window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"

